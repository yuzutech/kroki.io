{
  "name": "kroki.io",
  "version": "0.1.0",
  "homepage": "https://kroki.io",
  "engines": {
    "node": ">= 22"
  },
  "author": {
    "name": "Guillaume Grossetie",
    "email": "hello@kroki.io",
    "url": "https://yuzutech.fr"
  },
  "devDependencies": {
    "@primer/css": "^21.5.1",
    "autoprefixer": "10.6.1",
    "bulma": "0.9.4",
    "clean-css-cli": "5.6.3",
    "pako": "1.0.11",
    "postcss": "^8.5.31",
    "postcss-cli": "12.0.0",
    "sass": "1.106.1"
  },
  "scripts": {
    "build": "npm run build-clean && npm run build-sass && npm run build-autoprefix && npm run build-cleancss",
    "build-autoprefix": "postcss --use autoprefixer --map false --output css/main.css css/main.css",
    "build-cleancss": "cleancss -o css/main.min.css css/main.css",
    "build-sass": "sass --style=expanded --source-map --load-path=node_modules --quiet-deps --silence-deprecation=import src/main.sass css/main.css",
    "build-clean": "node -e \"require('fs').rmSync('css', { recursive: true, force: true })\"",
    "generate-examples": "node scripts/generate-examples.js",
    "generate-cheatsheet": "npm install --prefix scripts/cheatsheet && node scripts/cheatsheet/generate.js",
    "deploy": "npm run build",
    "start": "npm run build-sass -- --watch"
  },
  "private": "true",
  "volta": {
    "node": "24.22.1"
  }
}
